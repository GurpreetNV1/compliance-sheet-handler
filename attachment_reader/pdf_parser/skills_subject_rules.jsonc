// TRA (Trades Recognition Australia) -- the 999-family reference is TRA's
// PSA/JRP pathway, which pays at submission time. The Payment Receipt IS
// the lodgement event there (confirmed from a real sample: body said
// "successfully paid and submitted") -- must stay ahead of the generic
// Payment Receipt -> notification fallback down in the cross-authority
// section below.
{
  "subject_contains": ["Payment Receipt"],
  "subject_regex": "TRA\\d{2}/999\\d+",
  "tab": "lodgement"
},
{"subject_contains": "Acknowledgement of Application for Assessment", "tab": "notification"},
{"subject_contains": "Migration Skills Assessment TRA", "tab": "notification"},
{"subject_contains": "PROVISIONAL SKILLS ASSESSMENT (PSA) - OUTCOME", "tab": "outcome"},
{"subject_contains": "PSA VERIFICATION REQUEST", "tab": "notification"},
{"subject_contains": "PSA - ADDITIONAL", "tab": "request_info"},

// TRA -- JRP (Job Ready Program), its own tab
{"subject_contains": "Job Ready Program", "tab": "jrp"},
{"subject_contains": "Job Ready Workplace", "tab": "notification"},
{"subject_contains": "JRFA Outcome", "tab": "jrp"},
{"subject_contains": "JRFA Invite", "tab": "notification"},
{"subject_contains": "JRWA", "tab": "jrp"},
{"subject_contains": "Job Ready Employment", "tab": "jrp"},
{"subject_contains": "Job Ready Final", "tab": "jrp"},
{"subject_contains": "Additional Documents Required from Applicant", "tab": "request_info"},


